<?xml version="1.0"?>
<bindings>
  <context name="AWRadioFrameworkTrackControls">
    <action name="AWRadioSkipSong" map="AWRadioSkipSong_Button" />
    <action name="AWRadioToggleRepeatSong" map="AWRadioToggleRepeatSong_Button" />
    <action name="AWRadioSkipSongController" map="AWRadioSkipSongController_Button" />
    <action name="AWRadioToggleRepeatSongController" map="AWRadioToggleRepeatSongController_Button" />
  </context>

  <context name="UIExploration" append="true">
    <include name="AWRadioFrameworkTrackControls" />
  </context>

  <mapping name="AWRadioSkipSong_Button" type="Button">
    <button id="IK_L" overridableUI="AWRadioSkipSongKey" />
  </mapping>

  <mapping name="AWRadioToggleRepeatSong_Button" type="Button">
    <button id="IK_U" overridableUI="AWRadioRepeatSongKey" />
  </mapping>

  <mapping name="AWRadioSkipSongController_Button" type="Button">
    <button id="IK_AWRadioSkipControllerCombo" />
  </mapping>

  <mapping name="AWRadioToggleRepeatSongController_Button" type="Button">
    <button id="IK_AWRadioRepeatControllerCombo" />
  </mapping>

  <buttonGroup id="IK_AWRadioSkipControllerCombo" timeWindow="0.08f">
    <button id="IK_Pad_LeftShoulder" />
    <button id="IK_Pad_DigitRight" />
  </buttonGroup>

  <buttonGroup id="IK_AWRadioRepeatControllerCombo" timeWindow="0.08f">
    <button id="IK_Pad_LeftShoulder" />
    <button id="IK_Pad_DigitLeft" />
  </buttonGroup>
</bindings>
